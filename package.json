{
  "name": "persian-rtl-markdown-preview",
  "displayName": "Persian RTL Markdown Preview",
  "description": "Edit and preview Persian/Farsi Markdown, TXT and SRT with correct RTL and mixed-language layout.",
  "version": "1.1.0",
  "publisher": "sinatabar",
  "author": {
    "name": "Sina Tabar",
    "url": "https://github.com/sinatabar"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinatabar/vscode-persian-rtl-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/sinatabar/vscode-persian-rtl-markdown-preview/issues"
  },
  "homepage": "https://github.com/sinatabar/vscode-persian-rtl-markdown-preview#readme",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onCustomEditor:persianRtl.editor",
    "onCommand:persianRtl.openEditor"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#161b22",
    "theme": "dark"
  },
  "keywords": [
    "persian",
    "farsi",
    "rtl",
    "right-to-left",
    "bidi",
    "bidirectional",
    "markdown",
    "markdown-preview",
    "preview",
    "mixed-language",
    "arabic-script"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "persianRtl.openEditor",
        "title": "Open with Persian RTL Editor"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "persianRtl.openEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .txt || resourceExtname == .srt",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "persianRtl.editor",
        "displayName": "Persian RTL Editor",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.txt" },
          { "filenamePattern": "*.srt" }
        ],
        "priority": "option"
      }
    ],
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
