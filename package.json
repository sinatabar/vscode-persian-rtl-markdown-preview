{
  "name": "persian-rtl-markdown-preview",
  "displayName": "Persian RTL Markdown Preview",
  "description": "Correct Persian/Farsi RTL and mixed English-Persian text in VS Code's built-in Markdown Preview.",
  "version": "1.0.2",
  "publisher": "sinatabar",
  "author": {
    "name": "Sina Tabar",
    "url": "https://github.com/sinatabar"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinatabar/vscode-persian-rtl-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/sinatabar/vscode-persian-rtl-markdown-preview/issues"
  },
  "homepage": "https://github.com/sinatabar/vscode-persian-rtl-markdown-preview#readme",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#161b22",
    "theme": "dark"
  },
  "keywords": [
    "persian",
    "farsi",
    "rtl",
    "right-to-left",
    "bidi",
    "bidirectional",
    "markdown",
    "markdown-preview",
    "preview",
    "mixed-language",
    "arabic-script"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "markdown-it": "^14.1.0"
  }
}
